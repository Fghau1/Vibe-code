[global]
    monitor = 0
    follow = mouse
    width = (0, 300)
    origin = bottom-center
    offset = (0, 60)
    corner_radius = 8
    frame_width = 1
    frame_color = "#333333"
    gap_size = 6
    padding = 12
    horizontal_padding = 14
    font = JetBrainsMono Nerd Font 11
    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 0
    progress_bar_corner_radius = 3
    separator_height = 0
    format = "<b>%s</b>\n%b"
    icon_position = off
    indicate_hidden = no
    sort = no

[urgency_low]
    background = "#000000"
    foreground = "#FFFFFF"
    highlight = "#FFFFFF"
    timeout = 2

[urgency_normal]
    background = "#000000"
    foreground = "#FFFFFF"
    highlight = "#FFFFFF"
    timeout = 5

[urgency_critical]
    background = "#000000"
    foreground = "#FFFFFF"
    frame_color = "#FFFFFF"
    highlight = "#FFFFFF"
    timeout = 0
