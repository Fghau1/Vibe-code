/* 10Hour wallpaper grid — matches config.rasi */
* {
    background-color: transparent;
    text-color: #6C6C6D;
    font: "JetBrains Mono 11";
    margin: 0px;
    padding: 0px;
    spacing: 0px;
}

window {
    location: center;
    width: 1000px;

    border-radius: 12px;
    border: 0px;

    background-color: #0D0B0A;
}

mainbox {
    padding: 16px;
    spacing: 12px;
    background-color: #0D0B0A;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: #14110E;
    border-radius: 6px;
    border: 0px;

    padding: 8px 12px;
    spacing: 8px;
    children: [ prompt, entry ];
}

prompt {
    text-color: #B0B0B2;
    background-color: transparent;
}

entry {
    text-color: #6C6C6D;
    placeholder: "wallpaper";
    placeholder-color: #6C6C6D;
    background-color: transparent;
}

listview {
    background-color: #0D0B0A;
    margin: 4px 0 0;

    columns: 4;
    lines: 2;
    spacing: 12px;
    fixed-columns: true;
    scrollbar: false;
}

element {
    orientation: vertical;
    padding: 8px;
    spacing: 8px;
    border-radius: 8px;
    background-color: #0D0B0A;
}

element normal.normal {
    background-color: #0D0B0A;
    text-color: #6C6C6D;
}

element selected.normal {
    background-color: #14110E;
    text-color: #B0B0B2;
}

element-icon {
    size: 220px;
    border-radius: 6px;
    horizontal-align: 0.5;
}

element-text {
    horizontal-align: 0.5;
    text-color: inherit;
    background-color: transparent;
}
